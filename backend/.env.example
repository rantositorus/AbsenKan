# Server
PORT=3000
API_PREFIX=api
NODE_ENV=development

# JWT
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=8h
SESSION_TTL_MIN=30

# Database (MySQL via docker compose)
DB_HOST=localhost
DB_PORT=3306
DB_USER=absenkan
DB_PASSWORD=absenkan
DB_NAME=absenkan

# File
UPLOAD_DIR=./uploads
MAX_PHOTO_SIZE_MB=5
PHOTO_RETENTION_MONTHS=12

# Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Seed
SEED_ADMIN_IDENTIFIER=admin
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_ADMIN_NAME=Admin HRD
SEED_ADMIN_POSITION=HR Manager
SEED_ADMIN_DEPARTMENT=HRD

# Working hours (default, overridable in settings table)
DEFAULT_CHECK_IN_TIME=09:00
DEFAULT_CHECK_OUT_TIME=18:00
